<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="DR-GW-Interface/DR-GW-Recording.Events"
  targetNamespace="DR-GW-Interface/DR-GW-Recording.Events" elementFormDefault="qualified"
  attributeFormDefault="unqualified" xmlns:ct="DR-GW-Interface/CommonTypes"
  xmlns:ctR="DR-GW-Interface/DR-GW-Recording.CommonTypes">
  <!-- *************************************************************** -->
  <xs:annotation>
    <xs:documentation>Version 1.2</xs:documentation>
    <xs:documentation>DR-GW-Recording. Use for Archive recording applications. </xs:documentation>
  </xs:annotation>

  <!-- *************************************************************** -->
  <xs:import namespace="DR-GW-Interface/DR-GW-Recording.CommonTypes"
    schemaLocation="DR-GW-Recording.CommonTypes.xsd"/>
  <xs:import namespace="DR-GW-Interface/CommonTypes" schemaLocation="../Types/CommonTypes.xsd"/>

  <!-- *************************************************************** -->
  <xs:element name="Record_Response" type="ct:typeResponse"/>

  <!-- *************************************************************** -->
  <xs:element name="Record_GroupEvent" type="typeRecordEvent">
    <xs:annotation>
      <xs:documentation>The method is used to inform about the result of placing group under either
        statistical(signaling and data) or active(audio and data) recording. </xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- *************************************************************** -->
  <xs:element name="Record_IndividualEvent" type="typeRecordEvent">
    <xs:annotation>
      <xs:documentation>The method is used to inform about the result of placing individual
        subsriber under either statistical(signaling and data) or active(audio and data) recording.
      </xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- *************************************************************** -->
  <xs:complexType name="typeRecordEvent">
    <xs:complexContent>
      <xs:extension base="ct:typeEvent">
        <xs:sequence>
          <xs:element name="sel" type="ctR:typeSelection"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
